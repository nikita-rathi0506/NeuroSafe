{
  "manifest_version": 3,
  "name": "NeuroSafe",
  "version": "1.0",
  "description": "AI-powered sensory shield",
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_page": "options/option.html",
  "permissions": [
  "storage",
  "activeTab",
  "scripting",
  "tts",
  "tabCapture"
  ],
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/content.js"],
    "run_at": "document_end"
  }],
  "web_accessible_resources": [{
    "resources": [
      "assets/panic-overlay.css",
      "assets/OpenDyslexic.woff2",
      "assets/greyscale.css"
    ],
    "matches": ["<all_urls>"]
  }],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}